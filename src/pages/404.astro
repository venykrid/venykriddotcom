---
import type { ImageMetadata } from "astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";

const catModules = import.meta.glob<{ default: ImageMetadata }>(
  "../images/404cats/*.webp",
  { eager: true },
);
const catUrls = Object.values(catModules).map((mod) => mod.default.src);
const fallbackCat = catUrls[0] ?? "";
---

<BaseLayout
  title="404 - Page Not Found | venykrid.com"
  description="The requested page could not be found."
>
  <Navbar />
  <section class="content-wrapper not-found">
    <h1 class="error-code">404</h1>
    <p class="error-message">Wasn't expecting you to be here...</p>

    <div class="cat-frame">
      <img
        id="cat-404"
        alt="A random cat"
        width="800"
        height="800"
        decoding="async"
      />
      <noscript>
        {
          fallbackCat && (
            <img src={fallbackCat} alt="A cat" width="800" height="800" />
          )
        }
      </noscript>
    </div>

    <div class="actions">
      <a href="/" class="btn btn-primary">Go home</a>
      <button type="button" id="another-cat" class="btn btn-secondary">
        Another cat
      </button>
    </div>
  </section>
</BaseLayout>

<script is:inline data-astro-rerun define:vars={{ catUrls }}>
  const img = document.getElementById("cat-404");
  const btn = document.getElementById("another-cat");

  function pickCat(exclude) {
    if (!catUrls || catUrls.length === 0) return "";
    if (catUrls.length === 1) return catUrls[0];
    let choice = catUrls[Math.floor(Math.random() * catUrls.length)];
    while (choice === exclude) {
      choice = catUrls[Math.floor(Math.random() * catUrls.length)];
    }
    return choice;
  }

  if (img && catUrls.length > 0) {
    img.src = pickCat("");
    btn?.addEventListener("click", () => {
      img.src = pickCat(img.getAttribute("src") || "");
    });
  }
</script>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-block: 2rem 3rem;
    gap: 1rem;
  }

  .error-code {
    font-family: "AdwaitaMono", monospace;
    font-size: clamp(3.5rem, 10vw, 6rem);
    line-height: 1;
    margin: 0;
    color: var(--ctp-red);
    letter-spacing: -0.05em;
  }

  .error-message {
    margin: 0;
    color: var(--ctp-subtext1);
    font-size: 1.1rem;
  }

  .cat-frame {
    width: min(360px, 85vw);
    aspect-ratio: 1 / 1;
    margin-block: 0.5rem;
    border-radius: 12px;
    border: 1px solid var(--ctp-surface0);
    background-color: var(--ctp-mantle);
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  }

  .cat-frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 0.25rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.6rem 1.2rem;
    border-radius: 8px;
    font-family: inherit;
    font-size: 1rem;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    border: 1px solid var(--ctp-surface0);
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease;
  }

  .btn-primary {
    background-color: var(--ctp-blue);
    color: var(--ctp-base);
    border-color: var(--ctp-blue);
  }

  .btn-primary:hover {
    opacity: 0.9;
  }

  .btn-secondary {
    background-color: var(--ctp-mantle);
    color: var(--ctp-text);
  }

  .btn-secondary:hover {
    background-color: var(--ctp-surface0);
  }
</style>
